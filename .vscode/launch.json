    "version": "0.2.1",
    "configurations": [
    
        {
            "name": "flutter_meta_wearables_dat",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "flutter_meta_wearables_dat (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter_meta_wearables_dat (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "example (Debug)",
            "cwd": "${workspaceFolder}/example",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "example (Profile)",
            "cwd": "${workspaceFolder}/example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart"
        },
        {
            "name": "example (Release)",
            "cwd": "${workspaceFolder}/example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart"
        },
        {
            "name": "example (iOS - Wait for Debugger)",
            "cwd": "${workspaceFolder}/example",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "waitForConnection": true
        },
        {
            "name": "Attach to Flutter (iOS)",
            "cwd": "${workspaceFolder}/example",
            "request": "attach",
            "type": "dart"
        }
    ]
}