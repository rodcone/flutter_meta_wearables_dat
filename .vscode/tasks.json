{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter: Build iOS (example)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "build",
                "ios",
                "--release",
                "--no-codesign"
            ],
            "options": {
                "cwd": "${workspaceFolder}/example"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Flutter: Clean (example)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}/example"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Flutter: Get Dependencies (example)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "pub",
                "get"
            ],
            "options": {
                "cwd": "${workspaceFolder}/example"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}

