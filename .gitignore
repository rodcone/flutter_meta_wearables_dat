.idea/

# Claude Code local state (machine-local settings + agent worktrees).
# `.claude/skills/` is the exception: maintainer tooling that ships with the repo.
# (Not to be confused with `agent/claude/`, which is installed into *consumer* projects.)
.claude/*
!.claude/skills/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
# The mock add-on is a sibling package, so the root-anchored /build/ above
# doesn't cover its build artifacts.
flutter_meta_wearables_dat_mock_device/build/
/coverage/

# Meta GitHub repos used as reference
doc/android/meta-wearables-dat-android/
doc/ios/meta-wearables-dat-ios/

# --- SENSITIVE: Never commit these ---
# Android local.properties (contains flutter.sdk path + GitHub token for DAT SDK)
**/local.properties

# Meta Wearables DAT secrets (copy from .template files, fill with real values)
example/android/secrets.properties
example/ios/Flutter/Secrets.xcconfig

# Android signing keys (keystores and key.properties)
**/key.properties
**/*.keystore
**/*.jks