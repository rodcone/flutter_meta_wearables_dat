<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the DAT SDK provision a Wi-Fi link to the glasses' soft-AP
	     (NEHotspotConfiguration) for the high-bandwidth streaming/photo path. -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<!-- Lets the SDK read the current SSID to confirm/manage that Wi-Fi link. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
