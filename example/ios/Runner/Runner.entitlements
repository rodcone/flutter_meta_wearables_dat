<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Wi-Fi camera transport. The SDK joins the glasses' access point itself via
	     NEHotspotConfiguration, which needs HotspotConfiguration; wifi-info lets it
	     read the resulting association. Both must also be enabled on the App ID in
	     the Developer Portal — a paid account only. Matches Meta's CameraAccess
	     sample. Empty this file to go back to Bluetooth Classic. -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
