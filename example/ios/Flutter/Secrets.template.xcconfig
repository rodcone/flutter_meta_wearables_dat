// Copy this file to Secrets.xcconfig and fill in your values from
// https://wearables.developer.meta.com/devcenter
// Do not commit Secrets.xcconfig (it is in .gitignore)

META_APP_ID = YOUR_APP_ID
META_CLIENT_TOKEN = YOUR_CLIENT_TOKEN
// Apple Developer Team ID used for code signing (also settable in Xcode > Signing)
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Optional: override the example's bundle id and Meta AI callback scheme to
// match the app registered in your Developer Center project.
// APP_BUNDLE_ID = com.example.myapp
// APP_LINK_SCHEME = myscheme
